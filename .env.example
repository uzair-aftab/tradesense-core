# ============================================
# TradeSense - Environment Variables Template
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ============================================

# -----------------
# Data Source API Keys
# -----------------

# Finnhub - Free tier: 60 calls/min
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=

# Marketaux - Free tier: 100 calls/day (backup news source)
# Get your key at: https://www.marketaux.com/register
MARKETAUX_API_KEY=

# -----------------
# Reddit API (for sentiment analysis)
# -----------------
# Create app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=TradeSense/1.0

# -----------------
# Scanner Configuration
# -----------------

# Scan interval in seconds (default: 300 = 5 minutes)
SCAN_INTERVAL_SECONDS=300

# Enable batch mode instead of real-time (true/false)
BATCH_MODE=false

# -----------------
# Signal Thresholds (defaults shown)
# -----------------

# RSI thresholds
RSI_OVERSOLD=20
RSI_OVERBOUGHT=80

# Put/Call ratio threshold
PUT_CALL_RATIO_THRESHOLD=0.7

# Volume multiplier (signal when volume > X * 20-day avg)
VOLUME_MULTIPLIER=1.0

# -----------------
# Notification Settings
# -----------------

# Enable desktop notifications (true/false)
ENABLE_DESKTOP_NOTIFICATIONS=true

# -----------------
# Database
# -----------------

# SQLite cache database path
CACHE_DB_PATH=data/cache.db

# Cache TTL in seconds (default: 3600 = 1 hour)
CACHE_TTL_SECONDS=3600

# -----------------
# Logging
# -----------------

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path (leave empty for console only)
LOG_FILE_PATH=logs/tradesense.log
